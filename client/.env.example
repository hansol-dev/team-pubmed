# Keep empty in local development and Vercel.
# Vite proxies local /api requests to http://127.0.0.1:4000, while Vercel uses
# the same deployment's /api routes.
VITE_API_URL=

# Public Supabase browser settings. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
