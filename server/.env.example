NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to call the Express API.
CLIENT_ORIGIN=http://localhost:5173

# Supabase server settings. Prefer the transaction pooler DATABASE_URL on Vercel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project-ref:url-encoded-password@aws-0-your-region.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# OpenAI chat and RAG embeddings.
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# NCBI asks API clients to identify themselves. NCBI_API_KEY is optional.
NCBI_EMAIL=your-email@example.com
NCBI_API_KEY=
NCBI_TOOL=publium

# Used to discover legal open-access locations. Usually the same contact email.
UNPAYWALL_EMAIL=your-email@example.com

# Local development only. Create a dedicated Supabase Auth user whose email is
# local-dev@publium.local and put that user's UUID here. Leave empty on Vercel.
DEV_USER_ID=
